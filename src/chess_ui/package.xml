<?xml version="1.0"?>
<package format="3">
  <name>chess_ui</name>
  <version>0.1.0</version>
  <description>Lightweight web UI to move chess pieces via ROS 2 services.</description>
  <maintainer email="costin@example.com">Costin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>action_module</exec_depend>
  <exec_depend>chesslab_setup2_interfaces</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
